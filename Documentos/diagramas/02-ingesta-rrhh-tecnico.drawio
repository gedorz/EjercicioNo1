  <diagram id="02-ingesta-rrhh-tecnico-2" name="Controles técnicos">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2800" pageHeight="2130" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="02 Ingesta RRHH · controles y contratos técnicos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=37;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="2710" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Acme Solutions | Arquitectura de referencia | Cxx conserva la relación con los diagramas funcionales" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="81" width="2710" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Convenciones de lectura y controles que acompañan la topología" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="145" width="2710" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="205" width="1305" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Alcance y fronteras AWS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="n5">
          <mxGeometry x="18" y="14" width="1269" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="La región R y las AZ A/B son parámetros de diseño, no recursos desplegados. IAM es global; KMS, CloudWatch, Bedrock,&#10;OpenSearch y las funciones son regionales. Los endpoints están en la VPC del cliente; los servicios administrados&#10;permanecen fuera de ella." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="n5">
          <mxGeometry x="18" y="55" width="1269" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1400" y="205" width="1355" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Leyenda y criterios AWS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="n8">
          <mxGeometry x="18" y="14" width="1319" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Azul continuo: solicitud de datos y respuesta por la misma conexión. Naranja discontinuo: evento o integración administrada. Gris&#10;discontinuo: asociación o control. Los iconos y grupos proceden del paquete oficial AWS. No se declara una certificación de&#10;cumplimiento." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="n8">
          <mxGeometry x="18" y="55" width="1319" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Controles técnicos y contratos de acceso" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="450" width="2710" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="510" width="2710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Identidad y API" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="530" width="380" height="31" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="RRHH publica con un rol autorizado. EventBridge puede iniciar solo C09. El rol de C09 invoca C11 y las operaciones OCR necesarias; C11 no administra IAM. T03 es una cola estándar en R: su política permite&#10;sqs:SendMessage a EventBridge con SourceArn de la regla." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="527" width="2255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="" style="rounded=0;fillColor=white;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="650" width="2710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="VPC y transporte" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="670" width="380" height="31" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="SG-Lambda: sin entrada iniciada por clientes; salida TCP 443 a SG-VPCE. SG-VPCE: entrada TCP 443 desde SG-Lambda. DNS support/hostnames activos y DNS privado en los endpoints. Las NACL permiten el retorno. No&#10;se necesita NAT para los destinos representados. Para N03, SG-Lambda permite además TCP 443 hacia la prefix list regional de S3; la gateway endpoint policy limita buckets y operaciones." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="667" width="2255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="790" width="2710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="Bedrock" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="810" width="380" height="31" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="C11 usa bedrock:InvokeModel únicamente para C05. Modelo y dimensión de embeddings coinciden con la consulta. Los documentos se dividen en lotes acotados; los cuerpos grandes se conservan en S3 y el flujo transporta&#10;referencias." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="807" width="2255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="" style="rounded=0;fillColor=white;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="930" width="2710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="OpenSearch Serverless" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="950" width="380" height="31" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="N02 es de datos Classic; no confundirlo con el endpoint de control com.amazonaws.R.aoss. Política de red: AllowFromPublic=false y SourceVPCEs=[N02]. Además se requieren permisos IAM sobre la colección y una política&#10;de acceso a datos por índice." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="947" width="2255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1070" width="2710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="Separación de permisos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1090" width="380" height="31" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="Rol de ingesta: aoss:APIAccessAll sobre la colección y política de datos con WriteDocument/DescribeIndex. CreateIndex y cambios de políticas se reservan al despliegue. s3:GetObject/GetObjectVersion y PutObject solo en&#10;prefijos necesarios; kms:Decrypt/GenerateDataKey según operación." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="1087" width="2255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="" style="rounded=0;fillColor=white;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1210" width="2710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="Cifrado y registros" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1230" width="380" height="31" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="C08: bloqueo de acceso público, versionado y SSE-KMS; bucket policy exige HTTPS y permite las identidades y accesos de servicio previstos. C13 cifra también C06. C14 alerta de fallos, reintentos y ejecuciones fallidas;&#10;T01 audita las operaciones compatibles." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="1227" width="2255" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="Referencias oficiales consultadas el 7 de noviembre de 2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=27;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1380" width="2710" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="Iconos oficiales" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://aws.amazon.com/architecture/icons/">
          <mxGeometry x="45" y="1435" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="Seguridad Well Architected" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/wellarchitected/latest/security-pillar/welcome.html">
          <mxGeometry x="735" y="1435" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="Lambda y VPC" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/lambda/latest/dg/configuration-vpc.html">
          <mxGeometry x="1425" y="1435" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="Bedrock PrivateLink" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/bedrock/latest/userguide/vpc-interface-endpoints.html">
          <mxGeometry x="2115" y="1435" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="OpenSearch plano de datos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/opensearch-service/latest/developerguide/serverless-vpc.html">
          <mxGeometry x="45" y="1483" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="OpenSearch permisos de datos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/opensearch-service/latest/developerguide/serverless-data-access.html">
          <mxGeometry x="735" y="1483" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="S3 gateway endpoint" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/vpc/latest/privatelink/vpc-endpoints-s3.html">
          <mxGeometry x="1425" y="1483" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="OCR asincrono" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#176B91;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://docs.aws.amazon.com/textract/latest/dg/api-async.html">
          <mxGeometry x="2115" y="1483" width="660" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1625" width="1305" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="OCR y límites del workflow" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="n39">
          <mxGeometry x="18" y="14" width="1269" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="C09 ejecuta Start → Wait → Get mediante SDK, con plazo máximo y paginación NextToken. Cada página acotada se entrega&#10;a C11 para guardarla en S3. El estado conserva JobId y URI, no todo el texto; se respeta el límite de 256 KiB por estado." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="n39">
          <mxGeometry x="18" y="55" width="1269" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1625" width="1355" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="Versiones y manejo de fallos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="n42">
          <mxGeometry x="18" y="14" width="1319" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="C11 procesa por documento y versión de forma idempotente; controla eventos fuera de orden y publica solo tras validar. C09 debe&#10;serializar las sustituciones de un mismo documento; el mecanismo concreto se define al implementar. Catch registra y alerta fallos&#10;internos; T03 solo recoge fallos de entrega de EventBridge." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="n42">
          <mxGeometry x="18" y="55" width="1319" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="" style="rounded=0;fillColor=#F4F7FA;strokeColor=#CBD5E1;strokeWidth=2;dashed=0;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1885" width="2710" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="Alcance de las ampliaciones técnicas" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#172033;fontStyle=1;spacing=0;" vertex="1" parent="n45">
          <mxGeometry x="18" y="14" width="2674" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="N01/N02/N03 detallan conectividad. T01 añade auditoría y T03 una cola de errores de entrega. Los identificadores Cxx mantienen los servicios del diagrama original. Este diseño no sustituye una revisión de IAM, pruebas de aislamiento, selección de región y&#10;evaluación de costes de endpoints antes del despliegue." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="n45">
          <mxGeometry x="18" y="55" width="2674" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>